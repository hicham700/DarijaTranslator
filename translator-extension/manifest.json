{
    "manifest_version": 3,
    "name": "English → Darija Translator",
    "version": "1.0",
    "description": "Translate English text to Moroccan Arabic (Darija) using an LLM REST API.",
    "permissions": [
        "sidePanel",
        "activeTab",
        "storage"
    ],
    "host_permissions": [
        "http://localhost:8080/*"
    ],
    "background": {
        "service_worker": "background.js"
    },
    "side_panel": {
        "default_path": "sidepanel.html"
    },
    "icons": {
        "16": "icons/icone16.png",
        "48": "icons/icone16.png",
        "128": "icons/icone16.png"
    }
}